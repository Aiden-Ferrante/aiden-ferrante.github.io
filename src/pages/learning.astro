---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TopicTree from '../components/TopicTree.astro';
import { SITE_TITLE } from '../consts';
import { LEARNING_MAP, TOPIC_SLUGS } from '../data/learning-map';
import { postsByTopic } from '../lib/posts';

const posts = await postsByTopic();
const covered = TOPIC_SLUGS.filter((slug) => posts.has(slug)).length;

const title = 'Learning map';
const description =
	'The concepts I am working through, in order, and which ones I have written up so far.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.lede {
				color: rgb(var(--gray-dark));
			}
			.progress {
				margin: 1.5em 0 2.5em 0;
				padding: 0.8em 1em;
				background: rgb(var(--gray-light));
				border-radius: 8px;
				font-size: 0.95em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p class="lede">
				I keep a map of the concepts I intend to actually understand — not recognise, but be able
				to rebuild from scratch. This is that map, and it is mostly empty on purpose: a topic only
				gets marked off when there is a written explanation or a video behind it.
			</p>
			<p class="lede">
				The order matters more than the coverage. Each branch is arranged so the later entries
				need the earlier ones, which is also why the gaps are worth showing.
			</p>
			<p class="progress">
				<strong>{covered}</strong> of <strong>{TOPIC_SLUGS.length}</strong> topics written up so far.
			</p>
			<TopicTree nodes={LEARNING_MAP} posts={posts} />
		</main>
		<Footer />
	</body>
</html>
