---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SECTIONS } from '../data/sections';
import { postCountsBySection, publishedPosts } from '../lib/posts';

const posts = (await publishedPosts()).slice(0, 5);
const counts = await postCountsBySection();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.intro h1 {
				margin-bottom: 0.25em;
			}
			.tagline {
				color: rgb(var(--gray-dark));
				font-size: 1.15em;
			}
			h2 {
				margin-top: 2.5em;
				font-size: 1.2em;
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.4em;
			}
			.sections {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.2em;
			}
			.sections li {
				padding: 1em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
			}
			.sections h3 {
				margin: 0 0 0.2em 0;
				font-size: 1.15em;
			}
			.sections h3 a {
				text-decoration: none;
			}
			.sections p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.count {
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			@media (min-width: 720px) {
				.sections {
					grid-template-columns: 1fr 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm Aiden.</h1>
				<p class="tagline">
					I write about where artificial intelligence is actually going — the compute and capital
					behind it, what the machines can genuinely do, and who ends up deciding. I build the
					systems I write about, which is the only reason my opinions are worth more than anyone
					else's.
				</p>
			</section>

			<h2>What I write about</h2>
			<ul class="sections">
				{
					SECTIONS.map((s) => (
						<li>
							<h3>
								<a href={`/${s.slug}`}>{s.title}</a>
							</h3>
							<p>{s.tagline}</p>
							<p class="count">
								{counts.get(s.slug) ?? 0} {(counts.get(s.slug) ?? 0) === 1 ? 'post' : 'posts'}
							</p>
						</li>
					))
				}
			</ul>

			<h2>Recent</h2>
			<PostList posts={posts} empty="Nothing published yet — first post coming soon." showSection />
			<p><a href="/blog">All posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
