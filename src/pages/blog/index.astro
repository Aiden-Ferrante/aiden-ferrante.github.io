---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { publishedPosts } from '../../lib/posts';

const posts = await publishedPosts();
const description = 'Everything I have written, newest first.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing · ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			<PostList posts={posts} empty="Nothing published yet." showSection />
		</main>
		<Footer />
	</body>
</html>
